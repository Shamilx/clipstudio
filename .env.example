# Copy to .env and fill in. Never commit .env.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional: retried when the main model times out or returns bad JSON
NVIDIA_FALLBACK_MODEL=moonshotai/kimi-k3.1-pro
GROQ_API_KEY=
# Optional: cap encoder threads (empty = all cores)
RENDER_THREADS=
